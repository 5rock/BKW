# ============================================================
# GoldMarket — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Server
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/goldmarket

# JWT — generate a strong 64+ char random string for production
JWT_SECRET=goldmarket_jwt_secret_change_this_to_64char_random_string_in_prod
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Backend-controlled role lists (comma-separated emails)
ADMIN_EMAILS=admin@goldmarket.com
APPROVED_SELLER_EMAILS=seller@goldmarket.com

# Firebase Admin SDK (paste your service account values here)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Stripe
STRIPE_SECRET_KEY=sk_test_12345
STRIPE_WEBHOOK_SECRET=whsec_12345
