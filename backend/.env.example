# Backend environment — copy to .env and fill in values
PORT=5000

# JWT Configuration
# JWT_SECRET is required (min 32 chars). Access/refresh secrets are optional overrides.
JWT_SECRET=change-me-to-a-long-random-string-at-least-64-chars
# JWT_ACCESS_SECRET=optional-separate-secret-for-access-tokens
# JWT_REFRESH_SECRET=optional-separate-secret-for-refresh-tokens
# JWT_ACCESS_EXPIRES=15m
# JWT_REFRESH_EXPIRES=7d

# MongoDB (use either variable name)
MONGO_URI=mongodb://127.0.0.1:27017/goldmarket
# MONGODB_URI=

# Allow auth routes when using mock db.json (no MongoDB)
# ALLOW_MOCK_DB=true

# Comma-separated frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Role assignment — comma-separated emails
# ADMIN_EMAILS=admin@example.com
# APPROVED_SELLER_EMAILS=seller1@example.com,seller2@example.com

# Firebase Admin (optional — for social / Firebase token verification)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Gemini API (for AI Shopping Assistant features)
# GEMINI_API_KEY=your_gemini_api_key_here

# Stripe (for payment processing)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
