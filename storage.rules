rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && profile().isAdmin == true;
    }

    // FIX: Require email verification before allowing uploads
    function isVerifiedSeller() {
      return signedIn()
        && request.auth.token.email_verified == true
        && (profile().isSeller == true || profile().isAdmin == true);
    }

    // FIX: Validate image file type strictly using magic bytes where possible
    function isValidImage() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp|avif)')
             && request.resource.size < 8 * 1024 * 1024; // 8 MB max
    }

    // FIX: Validate 3D model file type strictly
    function isValidModel() {
      return request.resource.contentType.matches('model/gltf-binary|application/octet-stream')
             && request.resource.size < 15 * 1024 * 1024; // 15 MB max
    }

    // ── Product images (seller uploads) ────────────────────────────────────
    match /products/{userId}/{fileName} {
      // Public read — products should be visible to all
      allow read: if true;

      // FIX: Only the owner seller (verified) can write, with file validation
      allow create, update: if isVerifiedSeller()
        && request.auth.uid == userId
        && isValidImage();

      // FIX: Owner or admin can delete
      allow delete: if (signedIn() && request.auth.uid == userId && isVerifiedSeller())
                      || isAdmin();
    }

    // ── Product 3D Models (seller uploads) ─────────────────────────────────
    match /products/{userId}/{productId}/model/{fileName} {
      allow read: if true;

      allow create, update: if isVerifiedSeller()
        && request.auth.uid == userId
        && isValidModel();

      allow delete: if (signedIn() && request.auth.uid == userId && isVerifiedSeller())
                      || isAdmin();
    }

    // ── User avatars ─────────────────────────────────────────────────────────
    match /avatars/{userId}/{fileName} {
      allow read: if true;

      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.auth.token.email_verified == true
        && isValidImage()
        && request.resource.size < 2 * 1024 * 1024; // 2 MB max for avatars

      allow delete: if (signedIn() && request.auth.uid == userId) || isAdmin();
    }

    // FIX: Block all other paths — no wildcard uploads
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
